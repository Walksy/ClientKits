{
	"schemaVersion": 1,
	"id": "clientkits",
	"version": "${version}",
	"name": "Client Kits",
	"description": "Store, edit and load custom kits.",
	"authors": [
		"Walksy"
	],
	"contact": {
		"homepage": "https://discord.gg/zeu7uNuBWY",
		"issues": "https://github.com/Walksy/ClientKits/issues",
		"sources": "https://github.com/Walksy/ClientKits"
	},
	"license": "MIT",
	"icon": "assets/walksy/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"walksy.clientkits.ClientKits"
		],
		"walksylib": [
      "walksy.clientkits.config.ClientKitsConfig"
		]
	},
	"mixins": [
		{
			"config": "clientkits.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"walksylib": ">=2.0.0"
	},
	"recommends": {
		"modmenu": "*"
	}
}
